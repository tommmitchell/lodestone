# Copy to .env and fill in. .env is gitignored — never commit real keys.
# A real shell environment variable takes precedence over anything set here.

# Required for the Analyst tools (grounded Q&A, card proposals, red-team).
# Get one at platform.claude.com -> Settings -> API keys.
MY_ANTHROPIC_KEY=

# Hard cap on assistant spend per calendar day (UTC). Calls are refused at the
# cap rather than silently continuing to bill.
LODESTONE_DAILY_LIMIT_USD=2

# Optional. Enables the UN Comtrade model runner (m11). The free tier requires
# registration: https://comtradeplus.un.org/
COMTRADE_API_KEY=

# Optional. Enables the Battery Policies and Incentives runner (m13).
# Free key: https://developer.nlr.gov/signup
NLR_API_KEY=

# Optional. Server port.
PORT=8787
