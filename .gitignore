node_modules/
# Credentials. The bare name is not enough: editors leave backups such as
# .env.~1~ / .env.bak / .env.save, which are NOT matched by ".env" and would
# be swept up by "git add -A" into a public repo.
.env
.env.*
!.env.example
.spend.json
.config.json

# Assistant conversation logs — they quote workspace evidence verbatim.
conversations/

# Workspace backups — full copies of the evidence.
backups/
briefings/
changesets/

# Evidence content. The tool is public; the analysis is not.
# Start from public/seed.example.js.
public/seed.js

# Held back pending a decision: the specification is tool documentation, but it
# names the specific funding question it was written against. The .html is the
# source; the .pdf is rendered from it with headless Chrome.
# Delete these two lines to publish it.
LODESTONE-Specification.pdf
LODESTONE-Specification.html

# Third-party models. Excluded because they are either machine-specific or not
# ours to redistribute — see models/README.md for how to obtain each.
models/blast-venv/
models/BLAST-Lite/
models/*.xlsm
models/*.xlsx

.DS_Store
